                      "WebPage",
                      "BlogPosting",
                      "DigitalDocument",
                      "WebAPI"
                    ]
                  },
                  "@id": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "description": "A schema.org node for the result."
              }
            },
            "required": [
              "url",
              "name",
              "score"
            ]
          }
        },
        "_meta": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "response_type": {
              "type": "string",
              "const": "answer"
            },
            "dialect": {
