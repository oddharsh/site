  "parameters": {
    "askSite": {
      "query": "The question.",
      "streaming": "0, false, no or off returns one JSON body. Any other value, or none, streams text/event-stream.",
      "mode": "Only list is served. summarize and generate return 501 with supported_modes.",
      "site": "The only site is aadhar.sh.",
      "top_k": "Maximum results. `limit` is read when top_k is absent.",
      "prev": "Earlier queries in the conversation, comma-separated, at most 10.",
      "decontextualized_query": "If present, this string is searched instead of query.",
      "query_id": "Echoed back. A UUID is generated when absent."
    },
    "searchSite": {
      "q": "Search terms. Stopwords are dropped and at most 12 terms are used.",
      "limit": "Maximum results. Values outside the range are clamped, and a non-number falls back to the default."
    },
    "getNowPlaying": {},
    "queryPhotos": {
      "q": "Caption search; the only ranked field.",
      "camera": "Case-insensitive substring of the camera.",
      "lens": "Case-insensitive substring of the lens.",
      "film": "Case-insensitive substring of the film simulation.",
      "recipe": "Case-insensitive substring anywhere in the recipe card, for example DR400.",
      "from": "Earliest date, YYYY-MM-DD.",
      "to": "Latest date, YYYY-MM-DD.",
      "limit": "Page size. Values outside the range are clamped, and a non-number falls back to the default.",
      "offset": "Rows to skip."
    },
    "getCoffeeAvailability": {},
    "getChangeRadar": {
      "limit": "Maximum change records. Values outside the range are clamped, and a non-number falls back to the default."
    },
    "inspectUrl": {
      "url": "A public http or https URL, https:// if no scheme is given. Ports other than 80 and 443, credentials, and private or link-local hosts are refused.",
      "phases": "page limits the scan to fields derived from the page itself (one subrequest).",
      "mode": "cloudflare returns the Cloudflare Agent Readiness level instead of the full observation."
    },
    "compareUrls": {
      "left": "The first URL, validated like /lens/fetch.",
      "right": "The second URL."
    }
  }
