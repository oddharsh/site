# IMPORTANT: do NOT put Cache-Control on /*. Pages merges _headers rules
# from every matching pattern into one combined response, so a /* Cache-
# Control would merge with /images/*'s Cache-Control into a single header
# containing TWO max-age values. browsers (and the CF Cache Rule's "respect
# origin TTL") then pick the most-restrictive max-age per RFC 7234, which
# is the /* rule's short value — clobbering the 1-year immutable cache on
# thumbnails. instead: security headers on /*, Cache-Control on explicit
# paths below.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # CSP: every resource the site needs is same-origin. inline <style> and
  # <script> blocks are part of the perf design (one HTTP request gets you
  # everything — see /bot for the McMaster-Carr-school philosophy), so
  # 'unsafe-inline' is necessary. external scripts/stylesheets remain
  # blocked, which kills the most common XSS vector. data: URLs allowed
  # for the inlined-favicon SVG. frame-ancestors 'none' prevents
  # clickjacking. upgrade-insecure-requests rewrites any http:// to https://.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.scdn.co https://*.spotifycdn.com; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  # Permissions-Policy: explicitly opt out of every browser API we don't
  # use. shrinks fingerprinting surface and prevents stray code from popping
  # permission prompts. `interest-cohort=()` opts out of Google's FLoC/Topics
  # tracking experiment.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), serial=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), screen-wake-lock=(), hid=(), idle-detection=()
  X-Frame-Options: DENY

# thumbnails are content-addressed by filename (uploads keep their SOOC
# names — IMG_1234.jpg, DSCF5678.heic, etc.), never replaced in place.
# that makes them safe to cache for a year + immutable, which is what
# Lighthouse wants to see on static assets. if you ever DO replace a
# file at the same name, purge that URL in the CF dashboard.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# resto-mod car reference photos (homepage car-link tooltips). versioned via
# ?v=N in the markup, so safe to cache a year + immutable like the thumbnails.
# bump the ?v in index.html if a car image is replaced in place.
/cars/*
  Cache-Control: public, max-age=31536000, immutable

# garage experiment pages — active development mules, edited constantly. the
# browser must REVALIDATE every time (max-age=0) so fresh edits always show; the
# revalidation is a cheap 304 against the edge (s-maxage=86400), not the origin,
# and Pages purges the edge on each deploy so new bytes land immediately. paired
# with network-only in sw.js — no layer holds a stale garage page anymore.
/garage/*
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=86400

# homepage: hard no-store. the worker pre-renders a fresh 12-photo
# random pick on every request, and the visitor counter increments per
# human pageview. both effects require the worker to run on each visit —
# any cache (CF edge, browser, intermediary proxy, service worker)
# that stores the response would pin the same 12 photos and freeze the
# counter for as long as it serves the cached copy.
# `no-store` is the strongest directive: caches MUST NOT store. we
# pair it with `s-maxage=0` belt-and-suspenders for any cache that
# treats no-store loosely. cost: ~3 KV reads + 1 KV write per visit,
# well under free-tier budget at personal traffic.
# Also: advertise machine-readable resources for agents per RFC 8288 +
# RFC 9727 §3. multiple Link headers are valid; using one per resource
# for readability.
/
  Cache-Control: no-store, must-revalidate, s-maxage=0
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: </llms.txt>; rel="alternate"; type="text/plain"; title="llms.txt summary"
  Link: </auth.md>; rel="service-doc"; type="text/markdown"; title="Auth.md agent registration"
  Link: </.well-known/oauth-protected-resource>; rel="service-desc"; type="application/json"; title="OAuth protected resource metadata"
  Link: </.well-known/oauth-authorization-server>; rel="service-desc"; type="application/json"; title="OAuth authorization server metadata"
  Link: </rn/tracks>; rel="service-desc"; type="application/json"; title="current rn playlist as JSON"
  Link: </.well-known/http-message-signatures-directory>; rel="http-message-signatures-directory"; type="application/jwk-set+json"
  Link: </.well-known/security.txt>; rel="security-policy"; type="text/plain"
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Vary: Accept

# discovery files: long cache. these all change rarely (sitemap when
# new public pages land, robots.txt when bot policy shifts, llms.txt
# when site copy changes, JWKS when the bot's signing key rotates) —
# and when they do change, `wrangler kv` purges + a redeploy lands new
# bytes within a minute. Lighthouse's "Use efficient cache lifetimes"
# audit flags anything < 30 days, so 30d (2592000s) clears the bar
# while leaving room for manual purge if any of these change urgently.
/sitemap.xml
  Cache-Control: public, max-age=2592000, s-maxage=2592000

/robots.txt
  Cache-Control: public, max-age=2592000, s-maxage=2592000

/llms.txt
  Cache-Control: public, max-age=2592000, s-maxage=2592000
  Content-Type: text/plain; charset=utf-8

# JWKS at the well-known location for Web Bot Auth. content-type must be
# explicit because the path has no extension.
/.well-known/http-message-signatures-directory
  Content-Type: application/jwk-set+json
  Cache-Control: public, max-age=2592000, s-maxage=2592000

# agent discovery surfaces. content-types are explicit because the api-catalog
# path has no extension and the .md files must serve as markdown (not text/html
# or octet-stream). the .json cards under .well-known/mcp/ + agent-skills/ get
# application/json from Pages automatically. NO /.well-known/* wildcard here —
# per the merge note at the top of this file, a wildcard Cache-Control would
# clobber the explicit per-file rules.
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=86400
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=86400

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=86400

/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=86400

/.well-known/agent-skills/serendipity-events/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=86400

# (security.txt is served by Cloudflare's managed Security Center now —
# no local file, no _headers rule needed. the Link header on / and the
# llms.txt entry still resolve because the URL responds.)

# service worker — short cache so a bumped CACHE_VERSION propagates fast.
# Service-Worker-Allowed lets the worker control the full site (default
# scope is its own path, but root scope is what we want).
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=60
  Service-Worker-Allowed: /
