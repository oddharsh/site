# wrangler local cache + state (per-deploy, regenerates)
.wrangler/

# deploy-time build staging (build.mjs output; regenerated every build)
.build/

# the remote-bindings twin (scripts/gen-remote-config.mjs). Derived on demand from
# wrangler.jsonc / wrangler.dev.jsonc, and it lives at the ROOT rather than under
# .build/ because wrangler resolves main + assets.directory relative to the config
# file. Never commit it: its bindings point at PRODUCTION KV/R2/Browser.
.wrangler.remote.jsonc

# macOS
.DS_Store

# editor cruft
*.swp
*.swo
.vscode/
.idea/

# node (root: build.mjs minifiers + wrangler; workspaces cal/ cf-garage/ lwe-ask/ serendipity/)
# NO trailing slash, deliberately: a trailing slash restricts the rule to DIRECTORIES,
# and a worktree that symlinks node_modules at the main checkout to skip a second install
# then has an unignored symlink named node_modules. That is how one got committed in #227.
node_modules
npm-debug.log

# secrets — wrangler stores these in .dev.vars when running `wrangler dev`
.dev.vars

# Claude Code per-project transient state
.claude/projects/

# cf-garage worker deps (not committed)
cf-garage/node_modules/
.claude/launch.json
.claude/worktrees/

# zenc (JPEG thumbnail encoder) build artifacts — Cargo.lock is committed, target/ is not
www/scripts/zenc/target/

# verify-routes.mjs dev baselines against local servers (transient, per-port)
scripts/verify-baseline.localhost_*.json

# dcz deltas are BUILD OUTPUT now (build.mjs generates them with node:zlib zstd), not
# committed artifacts. Nothing to ignore here; this note exists so the directory is not
# re-added by hand.
www/ad/

# wrangler check startup writes this next to the config
worker-startup.cpuprofile

# The Python environment for gen-pixel-peeper.py, built by `pnpm run photos:env`.
# uv writes a `*` .gitignore inside the venv so it self-ignores, but that only
# holds while uv is the tool that made it; a hand-rolled `python -m venv` would
# not. Stated explicitly so the directory stays untracked either way.
www/scripts/.venv/
