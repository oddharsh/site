+// Generated pages reuse the same parser-pause eligibility rule as authored pages.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { renderBotPage } from "../bot.ts";
+import { renderDevelopersPage, renderPrivacyPage } from "../trust.ts";
+import { pauseBelowFirstScreen } from "../../../tools/lib/parser-pause.ts";
+import { foldLongProse } from "../../../tools/lib/prose-fold.ts";
+import { quizReference } from "../../../tools/lib/quiz-data.ts";
+
+test(
+  "generated non-quiz pages never acquire a quiz stylesheet parser pause",
+  { skip: typeof HTMLRewriter === "undefined" && "needs bun's HTMLRewriter" },
+  async () => {
+    for (const [path, render] of [
+      ["/bot", renderBotPage],
+      ["/privacy", renderPrivacyPage],
+      ["/developers", renderDevelopersPage],
+    ] as const) {
+      const html = foldLongProse(await render().text());
+      assert.equal(quizReference(html), null, `${path}: fixture must have no quiz`);
+      assert.equal(pauseBelowFirstScreen(html), html, `${path}: non-quiz page must not pause on quiz.css`);
+    }
+  },
+);
