{
  // Cloudflare Workers (static assets) config for aadhar.sh.
  // Migrated from the Pages project of the same name. The whole holding/ dir is
  // uploaded as static assets; holding/_worker.js/ is the bundled Worker entry
  // (excluded from assets by holding/.assetsignore). run_worker_first mirrors
  // Pages advanced mode (the worker sees every request and forwards static ones
  // to env.ASSETS via index.js:302). Compression is left to the platform default
  // for now (no precompression / q11 change in this migration).
  "name": "aadhar-sh",
  "main": "holding/_worker.js/index.js",
  "compatibility_date": "2026-06-01",
  // serve only on the custom domain (aadhar.sh); no public *.workers.dev URL.
  "workers_dev": false,
  "assets": {
    "directory": "holding",
    "binding": "ASSETS",
    // granular routing (safe cut): worker runs for everything EXCEPT the clearly-
    // static shell JS + content/SEO files + avif thumbnails, which serve edge-
    // direct (no worker invocation). negatives win over "/*".
    //
    // /images/*.avif: the primary + highest-volume image format (every modern
    // browser takes the avif <source>; jpg is only the ancient-browser fallback).
    // avif exists ONLY as thumbnails here — the R2 full-res originals under
    // /images/full/ are SOOC jpg/HIF, never avif — so this negation can't collide
    // with servePhotoFromR2. jpg is deliberately NOT excluded: "/images/*.jpg"
    // would (deep-wildcard) also match "/images/full/*.jpg" and starve the R2
    // route. The worker's thumbnail proxy was a Pages-era guard against the SPA
    // 200-html-stamped-immutable poison; Workers' default not_found_handling
    // returns a real 404, so that vector is gone. The only cost of going edge-
    // direct is a genuinely-missing avif getting the raw asset 404 (s-maxage=86400,
    // 24h edge cache) instead of the worker's 30s; acceptable because thumbs are
    // content-addressed (?v=N) and deploys are atomic (no transient miss of a real
    // file). manifest/meta/metadata/full stay worker-first (still guarded).
    "run_worker_first": [
      "/*",
      "!/nav.js", "!/lens.js", "!/notepad.js", "!/sw.js",
      "!/garage/*", "!/lwe/*", "!/cars/*",
      "!/images/*.avif",
      "!/sitemap.xml", "!/robots.txt", "!/llms.txt", "!/index.md", "!/bimi.svg", "!/README.md"
    ]
  },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "RN_KV", "id": "3cb8a107c58e47dc9244e75b33401f36" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS_R2", "bucket_name": "aadhar-photos" }
  ],
  "d1_databases": [
    { "binding": "RESTORE_DB", "database_name": "aadhar-restore", "database_id": "88c8daf1-3a36-4f8e-a2ad-dba8a74e1b9f" }
  ],
  "durable_objects": {
    "bindings": [
      // in-house now (no script_name) — the Counter class is defined + exported
      // by this worker (counter.js -> index.js). was cross-script to cf-garage.
      { "name": "COUNTER", "class_name": "Counter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter"] }
  ],
  "vars": {
    // account id for the /lens/shot Browser Rendering REST call. not secret.
    "CF_ACCOUNT_ID": "1c99acdb6141579023fb97d24261ea58",
    // one-time continuity: the new in-house Counter DO self-seeds to this on first
    // wake (carried over from cf-garage's counter, ~2375 at migration). idempotent;
    // safe to remove once the DO is seeded.
    "COUNTER_SEED": "2375"
  }
  // Secrets are NOT here (set on the Worker with `wrangler secret put`):
  //   RN_SIGNING_KEY_JWK, BROWSER_RENDER_TOKEN, RN_BUST_SECRET
}
