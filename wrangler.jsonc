{
  // Cloudflare Workers (static assets) config for aadhar.sh — the DEPLOY config.
  // Migrated from the Pages project of the same name. run_worker_first is an
  // allowlist that mirrors holding/_worker.js/index.js: static is the default,
  // and compute only runs where a route earns it. Compression is left to the
  // platform default for now (no precompression / q11 change in this migration).
  //
  // UNBYPASSABLE BUILD: main + assets point at .build/holding (the minified
  // tree), and the "build" block below runs build.mjs FIRST on every deploy.
  // So `wrangler deploy` (bare), `npm run deploy`, and Workers Builds all ship
  // the minified shells + luna.css — there is no longer a path that serves the
  // readable originals by accident (which is exactly how prod ended up on an
  // unminified 78KB nav.js). In Workers Builds, leave the dashboard's separate
  // Build command blank and set its Deploy command to `npx wrangler deploy`;
  // Wrangler then owns this one build instead of running it twice. Local dev
  // must NOT use this config (it would pay the full holding/ -> .build copy on
  // every reload); it uses wrangler.dev.jsonc, which points at holding/ directly.
  // The two configs' bindings must match; build.mjs warns on drift.
  "name": "aadhar-sh",
  "main": ".build/holding/_worker.js/index.js",
  "build": { "command": "node build.mjs" },
  "compatibility_date": "2026-06-01",
  "dependencies_instrumentation": { "enabled": true },
  // serve only on the custom domain (aadhar.sh); no public *.workers.dev URL.
  "workers_dev": false,
  "assets": {
    "directory": ".build/holding",
    "binding": "ASSETS",
    // canonical URLs carry NO trailing slash (sitemap.xml, both rel=canonical tags,
    // llms.txt and nav.js's own normalization all say so). drop-trailing-slash makes
    // the asset layer agree: /garage + /lwe serve directly, /garage/ + /lwe/ 301 to
    // the slashless form. MUST match wrangler.dev.jsonc, or dev diverges from prod.
    "html_handling": "drop-trailing-slash",
    // Worker-owned routes only. New static files do not cost invocations unless
    // they are added here and to the ROUTES/PREFIX tables in index.js.
    //
    // /images/<thumb> stays worker-first for one narrow reason: a real 404 under
    // /images/* must not inherit the immutable thumbnail cache rule. The old
    // Pages SPA-fallback content-type sniff is gone; the Worker now only clamps
    // asset 404 cache-control and passes every non-404 response through.
    "run_worker_first": [
      "/", "/index.html", "/favicon.ico", "/hit.svg",
      "/auth.md", "/.well-known/api-catalog", "/.well-known/agent-card.json",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-authorization-server",
      "/agent/*", "/oauth2/*",
      "/whoareyou", "/whoareyou.json", "/security",
      "/reading", "/updates", "/updates.json", "/restore",
      "/lens", "/lens/", "/lens/fetch", "/lens/shot", "/lens/browser",
      "/llms-full.txt", "/ledger", "/ledger.json",
      "/writing", "/writing/*",
      "/rn", "/rn/tracks", "/rn/tracks.html", "/rn/admin", "/rn/set",
      "/bot", "/around", "/around/json",
      "/photos", "/photos/", "/run",
      "/images", "/images/", "/images/full", "/images/full/*",
      "/images/manifest.json", "/images/metadata.json", "/images/meta/*",
      "/images/*.avif", "/images/*.jpg", "/images/*.jpeg",
      "/images/*.png", "/images/*.gif",
      "/images/*.heic", "/images/*.heif", "/images/*.hif"
    ]
  },
  "observability": { "enabled": true },
  // the deployed version id (changes every deploy). lib/cache.js folds it into
  // the caches.default key for rendered shells, so a deploy orphans the old
  // edge entries atomically instead of waiting out their TTL. Not populated in
  // local dev (the key falls back to "dev" there).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // the /around neighborhood crawl: per-generation, never per-visitor. The
  // request path only reads the KV snapshot this cron writes (around.js).
  "triggers": { "crons": ["*/30 * * * *"] },
  "kv_namespaces": [
    { "binding": "RN_KV", "id": "3cb8a107c58e47dc9244e75b33401f36" }
  ],
  // the bot ledger: identified AI-crawler hits tick in here (ledger.js);
  // /ledger reads them back via the SQL API (needs ANALYTICS_READ_TOKEN).
  "analytics_engine_datasets": [
    { "binding": "BOT_LEDGER", "dataset": "aadhar_bot_ledger" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS_R2", "bucket_name": "aadhar-photos" }
  ],
  "d1_databases": [
    { "binding": "RESTORE_DB", "database_name": "aadhar-restore", "database_id": "88c8daf1-3a36-4f8e-a2ad-dba8a74e1b9f" }
  ],
  "durable_objects": {
    "bindings": [
      // in-house now (no script_name) — the Counter class is defined + exported
      // by this worker (counter.js -> index.js). was cross-script to cf-garage.
      { "name": "COUNTER", "class_name": "Counter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter"] }
  ],
  // Browser Run Quick Actions. The binding is authenticated by Workers, so
  // Lens no longer needs a Browser Rendering API token for snapshots.
  "browser": { "binding": "BROWSER" },
  "vars": {
    // one-time continuity: the new in-house Counter DO self-seeds to this on first
    // wake (carried over from cf-garage's counter, ~2375 at migration). idempotent;
    // safe to remove once the DO is seeded.
    "COUNTER_SEED": "2375"
  }
  // Secrets are NOT here (set on the Worker with `wrangler secret put`):
  //   RN_SIGNING_KEY_JWK, BROWSER_RENDER_TOKEN (legacy, no longer read), RN_BUST_SECRET
}
