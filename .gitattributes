# Merge drivers for this repository's MACHINE-OWNED files. The argument for each
# class, the measurement behind it, and the ours/theirs inversion that decides
# their shape are all at the top of tools/merge-driver.ts.
#
# A driver named here does NOTHING until its definition exists in .git/config.
# `bun run setup:merge` wires config/gitconfig in; a clone that skips it merges
# these files by hand exactly as before, which is the safe direction to fail.

# Structural three-way merge over the parsed JSON. Resolves the add/add class
# (two branches each adding a different key) and still conflicts when both
# sides move the same key.
package.json                    merge=json
config/derivations.json         merge=json

# Resolve to the newer pin; the gate it is owed gets reported, never skipped.
config/bun-pin.json             merge=pin

# Derived. The merged text is never the answer, so these are parked and
# regenerated by tools/merge-finish.ts once the inputs are final.
bun.lock                        merge=regen
lens-reader/bun.lock            merge=regen
config/derivations.lock.json    merge=regen
