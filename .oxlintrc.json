{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // Two directories hold committed JavaScript that nobody here authored.
  // `a-dict` is the shell dictionary snapshots, which are minified BUILD INPUT
  // captured off the wire, and `pretext.lib.js` is @chenglou/pretext 0.0.7
  // vendored same-origin so /garage/pretext can load it under `script-src
  // 'self'`. Linting either one reports on somebody else's minifier.
  "ignorePatterns": ["src/dict/a-dict/**", "public/garage/pretext.lib.js", ".build/**", "tools/oxlint/anti-slop/**"],

  // NAMING ANY PLUGIN REPLACES THE DEFAULT SET, so this list has to restate the
  // four that were on implicitly. Measured 2026-08-15: with `"plugins":
  // ["vitest"]` alone, a planted `Promise.all([p])` stopped reporting
  // unicorn/no-single-promise-in-promise-methods entirely. Nothing warns, the
  // lint still exits 0, and the tree reads as clean because most of the rules
  // that were checking it are gone. Adding a plugin here means appending to
  // this array, never writing the one you want.
  // `import` is appended rather than swapped in, per the paragraph above. It
  // brings NOTHING on by itself: measured 2026-08-27 on oxlint 1.80.0, the
  // plugin with no named rule reports 0 on this tree AND 0 on a planted
  // two-file cycle, because none of the four rules named below sit in the
  // `correctness` category this config enables. So each one is listed
  // explicitly under `rules`, and adding the plugin costs no unnamed sweep.
  "plugins": ["eslint", "unicorn", "typescript", "oxc", "vitest", "import"],

  // Three rules vendored from dmmulroy/anti-slop, at tools/oxlint/anti-slop.
  // That directory is ignorePattern'd above: it is TypeScript in a repository
  // with no TypeScript, so linting it reports on somebody else's source under
  // rules written for ours.
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],

  "categories": { "correctness": "error" },

  // A suppression that no longer suppresses anything is a claim about the code
  // that has quietly stopped being true, and every one in this tree carries a
  // reason next to it (gotcha 35's three are the sharpest: they say a fix would
  // re-mint a content-addressed URL). When the underlying finding goes away the
  // reason goes stale, and nothing else here would notice.
  //
  // `deny` rather than `warn`, deliberately. The severity is per-directive and
  // takes allow/warn/deny, so an unused one can be an ERROR without reaching for
  // `denyWarnings`, which is a global promotion that would also catch every
  // future warn-severity rule and every reclassification oxlint ships. One
  // narrow gate beats one broad one.
  //
  // 0 findings on this tree, measured 2026-08-27. It has teeth: a planted
  // `// oxlint-disable-next-line no-sparse-arrays` above a clean line reports.
  "options": { "reportUnusedDisableDirectives": "deny" },

  "rules": {
    // Three rules fire only on idioms this codebase uses deliberately and
    // consistently. Each is relaxed rather than suppressed per-site, because a
    // rule that needs 96 inline disables is a rule that disagrees with the
    // house style, and the disables would be the noise instead.

    // 96 sites, all `catch { }` or `catch (e) { }` swallowing a failure the
    // caller is designed to survive: a disallowing robots.txt, an absent KV
    // entry, a third party that will not parse. The deliberate quiet
    // degradation those sites implement is documented all over CLAUDE.md, and
    // `cron.*` / `around.neighbor` spans exist precisely because it is quiet.
    //
    // `args: "none"` is the same argument at a different address. Worker,
    // Durable Object and cron signatures are POSITIONAL and fixed by the
    // platform: `fetch(request, env, ctx)` must accept `ctx` whether or not it
    // uses it, so an unused trailing parameter here is a contract rather than
    // an oversight. 15 sites, 11 of them `ctx`.
    "no-unused-vars": [
      "error",
      {
        "caughtErrors": "none",
        "args": "none",
        // `const { [HISTOGRAM_KEY]: _hist, ...exif } = ...` is how three files
        // here drop one key while keeping the rest. Both options are ESLint's
        // own defaults for that idiom; oxlint ships them off.
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_"
      }
    ],

    // 9 sites, every one the match-fallback idiom:
    //     (html.match(/<title>(.*?)<\/title>/) || [, ""])[1]
    // The hole at index 0 stands for the full match, which is discarded on
    // purpose. Writing it out as `[undefined, ""]` says less, not more.
    "no-sparse-arrays": "off",

    // 11 sites, 9 of them in check-infra.mjs, all one reporting shape:
    //     same ? pass(`nameservers match`) : drift(`...`)
    // A ternary used as a statement for its side effects is the house form for
    // every tier of that script. allowShortCircuit covers the `x && f()` twin.
    "no-unused-expressions": ["error", { "allowTernary": true, "allowShortCircuit": true }],

    // OFF because its AUTOFIX introduced a real regression here, measured
    // 2026-08-14. In webmention.js the spread is load-bearing:
    //
    //   [...new Uint8Array(d).slice(0, 12)].map((b) => b.toString(16)...)
    //
    // `--fix` rewrote it to `new Uint8Array(d).slice(0, 12).map(...)`, and
    // TypedArray.prototype.map returns a TYPED ARRAY, so every hex string it
    // produced was coerced straight back to a number. The id for a fixed digest
    // went from `deadbeef0102030405060708` to `000012345678`, which is not an
    // error, not a test failure, and not visible in a diff review that trusts
    // the fixer. It would simply have changed every webmention id and broken
    // dedup against the rows already in D1.
    //
    // The rule is right about plain arrays and cannot tell the two apart here,
    // so it is off rather than disabled per-site: one silent wrong autofix is
    // enough to stop trusting the family on a codebase this full of typed
    // arrays and crypto digests.
    "unicorn/no-useless-spread": "off",

    // `new Array(values.length)` in crawl.js pre-sizes the output of
    // mapWithConcurrency, which writes results back BY INDEX out of order. The
    // rule exists to catch `new Array(5)` where `[5]` was meant, and cannot see
    // the difference; every alternative it would accept (Array.from({length}),
    // a fill, a push loop) allocates or walks the array a second time to reach
    // the same place. Off rather than autofixed, for the same reason as above.
    "unicorn/no-new-array": "off",

    // The one rule worth taking from dmmulroy/anti-slop, an Oxlint plugin of
    // 15. Three of the other 14 fire on this tree and all three disagree with a
    // documented house idiom; ten cannot fire at all, since they visit only
    // TypeScript AST nodes and nothing here is TypeScript. Nothing was vendored,
    // because core Oxlint already ships this one.
    //
    // `cal/` was the only Vitest project in the tree; it runs on bun:test since
    // 2026-09-02 and its 7 test files use real seams, so this is a tripwire on
    // zero existing sites rather than a cleanup. It is worth keeping because a
    // module mock is the cheapest wrong turn available to anyone extending
    // those tests: it would pass while asserting against a fake booking store,
    // on the surface where a bug means a real person double-booked. Know its
    // reach: bun spells the same mistake `mock.module`, which this rule does not
    // match. The one `mock.module` in the tree is cal/test/preload.ts, a
    // virtual module for the `cloudflare:workers` scheme, and its header argues
    // why that is a runtime shim rather than a faked seam. The 12 remaining anti-slop rules are not
    // vendored; docs/DEPENDENCIES.md records the measurement that decided each one.
    // Rejects `...(cond ? { k } : {})`. The absent-rather-than-zero discipline
    // that idiom implements is RIGHT and is kept: a `score: 0` on a filter-only
    // query reads as "scored and found wanting" when nothing was scored, and the
    // photo pipeline, the span attributes and the /lens payloads all omit rather
    // than fabricate. What the rule objects to is spelling it as a spread, which
    // hides the omission inside an expression. Building the object and adding the
    // key under an `if` says the same thing where a reader can see it.
    //
    // 12 sites, none of them in a content-hashed client asset, so this costs no
    // page rebuild and no dictionary roll (gotcha 35).
    "anti-slop/no-conditional-empty-object-spread": "error",

    // Bans the term outright and takes no options, which is why the rename
    // rather than a config was the work. The three lens counters are
    // `documentTally` / `plainTally` now, the two probe classifiers are
    // `lensSitemapVerdict` / `lensJsonVerdict`, and the /lens/browser payload
    // key is `tally`. Every one of those names says what the value IS, where
    // "shape" only said that it had structure.
    //
    // `anatomy` was the obvious target and is WRONG: it is already a lens tab
    // name and already a payload key, so the rename would have collided with
    // live vocabulary rather than replaced dead vocabulary.
    "anti-slop/no-shape-in-symbol-names": "error",

    // Wants input parsed where it ENTERS, then branched on a trusted value,
    // rather than `typeof`-checked at each use. The argument is right and this
    // Worker had the failure it describes: the same "is this really a string?"
    // was asked in a dozen places and answered slightly differently in each.
    //
    // A schema library is the usual answer and was NOT taken. This repo
    // declares zero runtime dependencies and the bundle sits on a 204.24 KiB
    // baseline, so the parse layer is hand-rolled: `lib/parse.js` for the
    // Worker, a few local coercions per client IIFE (they cannot import).
    //
    // The two exemptions below are the classes the rule is categorically wrong
    // about, and both are language facts rather than preferences.
    "anti-slop/no-runtime-typeof": "error",

    // The complement of no-floating-promises, which the note at the end of the
    // type-aware block above keeps ON for one reason: this runtime cancels "a
    // promise nobody awaited" at request teardown. An async function handed to
    // a caller that expects a void return is the same promise, dropped one step
    // earlier, so the same argument covers it. 0 findings, measured 2026-08-27;
    // it fires on a planted `list.filter(async …)` and on `if (work())`.
    "typescript/no-misused-promises": "error",

    // A switch over a union that stops matching every member is how a new
    // variant reaches production silently. This repo dispatches on string
    // unions all over the Worker, and `noFallthroughCasesInSwitch` catches the
    // other half of the same failure. 0 findings, measured 2026-08-27; it fires
    // on a two-member union missing a case.
    "typescript/switch-exhaustiveness-check": "error",

    // FOUR IMPORT RULES, each measured at 0 on this tree on 2026-08-27 and each
    // proven to fire on a planted violation, because a rule that reports
    // nothing looks identical to a rule that is not running. oxlint accepts an
    // unknown rule name in silence, which is what makes the control mandatory
    // here rather than tidy: `-D typescript/no-such-rule-xyz` exits 0 with no
    // output, exactly like a clean pass.
    //
    // `import/no-unresolved` was wanted and DOES NOT EXIST in oxlint 1.80.0.
    // It is absent from configuration_schema.json, so naming it would have been
    // four silent no-ops dressed as a check.
    //
    // no-cycle earns the most here. The tools import Worker modules by their
    // real `.ts` filename across three resolution trees (tsconfig.tools.json's
    // header has the reason), which is precisely the shape a cycle hides in.
    "import/no-cycle": "error",
    "import/export": "error",
    // Skips `.ts` files by design, upstream and here: type-only re-exports are
    // not resolvable this way. It has teeth on the .js/.mjs half of the tree,
    // which is all of src/client and most of tools.
    "import/named": "error",
    "import/no-self-import": "error",

    "vitest/no-restricted-vi-methods": [
      "error",
      {
        "mock": "Use a real dependency seam. A module mock asserts against a fake.",
        "doMock": "Use a real dependency seam. A module mock asserts against a fake."
      }
    ]
  },

  // Type-aware linting, via tsgolint, enabled by `--type-aware` in the `lint`
  // script. It costs 0.56s over the whole tree, which is less than the tsc pass
  // it runs beside, so there is no reason to split it into a second script.
  //
  // TRIAGE WARNING, learned the expensive way on the day this landed: how much
  // this pass REPORTS depends on how much of the dependency graph resolves. A
  // first triage ran against a root-only install and came back with 56 findings;
  // after a full `pnpm install` populated the workspace, `@types/node` resolved,
  // `test()` typed as returning a promise, and the same command reported 272
  // more. Nothing had changed in the source. So triage a rule against a COLD
  // `pnpm install --frozen-lockfile`, which is what CI runs, and treat a count
  // taken from a partial install as a floor. Same shape as the lens-reader
  // lesson in CLAUDE.md, from the other direction.
  //
  // Six of the eight type-aware families that fire on this tree fire because
  // the tree is unannotated JavaScript rather than because anything is wrong,
  // and they are off with the measurement that decided each one:
  //
  //   no-base-to-string (14) + restrict-template-expressions (12)
  //     Both want a provable `string` in a template literal. In a .js file with
  //     no JSDoc the value is `any`, so these fire on `${url}` where url is a
  //     URL and on `${method}` where method is a literal string. Neither is a
  //     defect; both would be if this were TypeScript.
  //
  //   require-array-sort-compare (10)
  //     `[...services].sort()` in ledger.js is a Set built from String(...), so
  //     it is provably strings to a reader and `Set<any>` to the checker. The
  //     rule's own `ignoreStringArrays` option cannot help when the element type
  //     is unknowable.
  //
  //   no-misused-spread (8)
  //     `[...str]` splitting a string into code points. Correct to flag when the
  //     input might carry emoji; every site here spreads ASCII the build just
  //     produced.
  //
  //   unbound-method (5)
  //     All five are in lens-tools.js, on `read: inner.read`. Every `read` is a
  //     CLOSURE over a DOM node (the file says so at its renderer comment: "a
  //     plan in, DOM plus a read() closure out"), so none of them touch `this`.
  //
  //   no-implied-eval (2)
  //     Both are deliberate test technique in contract-tests.mjs: `new
  //     Function(script)` as a syntax check on inline blocks, and again to load
  //     a browser module under node. Each already carries a comment saying so.
  //
  // What stays on is the family that catches the failure this runtime actually
  // has: a promise nobody awaited, which workerd cancels at request teardown.
  "overrides": [
    {
      // The parse layer itself. A hand-rolled parser is MADE of `typeof`, so
      // the only thing this rule can buy is that the checks live in one named
      // place instead of at every call site. Turning it off here is what makes
      // turning it on everywhere else mean something; the file's own header
      // says the same thing from the other side.
      "files": ["src/worker/lib/parse.ts"],
      "rules": { "anti-slop/no-runtime-typeof": "off" }
    },
    {
      // The AUTHORING contract, which is the same argument one layer out: these
      // two files are the boundary parser for page content, and `requireText`
      // is literally "parse it where it enters, then branch on a value you can
      // trust". A validator is made of `typeof`; the rule cannot be satisfied
      // inside the thing it is asking you to build.
      "files": ["pipelines/content/page-contract.mjs", "pipelines/garage/generate.mjs"],
      "rules": { "anti-slop/no-runtime-typeof": "off" }
    },
    {
      // A test that asserts `typeof x === "boolean"` is CHECKING the contract,
      // which is the rule's goal rather than a violation of it. Rewriting these
      // through the parse layer would assert that the parse layer works, not
      // that the surface under test returns the right type. Same scoping as the
      // no-floating-promises entry below, and for a related reason.
      "files": ["**/test/**", "**/*.test.*", "tools/contract-shared.ts"],
      "rules": { "anti-slop/no-runtime-typeof": "off" }
    },
    {
      // `slide.shapes.add()` is the pptx library's API, not ours, so there is
      // nothing here to rename. The deck builder ships nothing and runs by hand.
      "files": ["talks/**"],
      "rules": { "anti-slop/no-shape-in-symbol-names": "off" }
    },
    {
      // `node:test` and Vitest both return a promise from `test()` that the
      // RUNNER tracks, so a top-level `test("...", async () => {})` is the
      // documented usage rather than a dropped promise. 272 of them here, and
      // `void` on every one would be noise that hides the rule's real subject.
      // Scoped to test files by name so the rule keeps its teeth everywhere a
      // Worker actually runs, which is the only place a floating promise gets
      // cancelled at request teardown.
      "files": ["**/test/**", "**/*.test.*", "tools/contract-shared.ts"],
      "rules": { "typescript/no-floating-promises": "off" }
    },
    {
      "files": ["**/*.js", "**/*.mjs"],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/no-misused-spread": "off",
        "typescript/unbound-method": "off",
        "typescript/no-implied-eval": "off"
      }
    }
  ]
}
