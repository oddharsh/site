// aadhar-counter: hosts the Counter Durable Object for aadhar-sh.
//
// Deployed by its own Workers Builds trigger on `production` since 2026-10-05
// (docs/MAINTENANCE.md, "Auxiliary Workers deploy themselves"), and always with
// `wrangler deploy`: a Durable Object lifecycle change is refused by `versions
// upload` (error 10211). The trigger runs .github/deploy-wrangler.sh with
// WRANGLER_CWD=counter; the workstation equivalent is
//
//   bun run wrangler deploy -c counter/wrangler.jsonc --x-provision=false --x-auto-create=false
//
// Counter was transferred here from aadhar-sh on 2026-09-29, in five
// alternating deploys: the site declared Counter in exports (#1004), this
// Worker expected it, the site marked it transferred and bound it here (#1006),
// this Worker became a plain sqlite class, and the site dropped the class code
// and tombstone (#1009). The namespace kept its id throughout, so the odometer
// and every coffee slot claim are the same objects they were in aadhar-sh. The
// sequence and both rehearsals are in the "Moving Counter out" section that
// CLAUDE.md carried until #1126 (`git show c3af691b^:CLAUDE.md`).
{
  "name": "aadhar-counter",
  "account_id": "1c99acdb6141579023fb97d24261ea58",
  "main": "src/index.ts",
  // The class runs under THIS Worker's compatibility settings since the
  // transfer, so they match aadhar-sh's date and flags, minus the
  // webcrypto_modern_algorithms flag aadhar-sh added on 2026-10-01 for
  // AadharshBot's ML-DSA signing, which nothing here calls. A drift here changes
  // the runtime the odometer and the slot claims run on without touching them.
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["enable_request_signal", "new_module_registry"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // HOW LIVE INSTANCES TAKE NEW CODE, declared rather than inherited. Since
  // workers-sdk#15658 (pinned from #945) every deploy sends a strategy, and an
  // unset one means "deferred, up to 300s". "homepage-visits" takes a request
  // on every homepage view, so it rarely idles and would sit out the full 300s
  // on old code while aadhar-sh, built from the same production commit, already
  // runs the new. Every request here is one storage read or write and the class
  // keeps nothing in memory, so 30s is room for in-flight work to finish while
  // keeping that window short. Not measured: the window is the platform's cap,
  // and nothing in this repo observes it.
  "durable_objects": {
    "code_update_strategy": { "mode": "deferred", "max_delay": 30 }
  },
  "exports": {
    "default": { "type": "worker" },
    "Counter": { "type": "durable-object", "storage": "sqlite" }
  }
}
