{
  "name": "aadhar-sh",
  "private": true,
  "description": "aadhar.sh - deploy-time transform only (authoring stays buildless; see build.mjs)",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "comment:workspaces": "pnpm does not read npm's `workspaces` field; the package list and the build allowlist live in pnpm-workspace.yaml. See that file, and CLAUDE.md gotcha 29 for why the release script is `deploy:direct` rather than `deploy`.",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "wrangler dev -c wrangler.dev.jsonc",
    "dev:remote": "node tools/gen-remote-config.mjs wrangler.dev.jsonc && wrangler dev -c .wrangler.remote.jsonc",
    "deploy:direct": "wrangler deploy --x-provision=false --x-auto-create=false --strict",
    "deploy:version": "wrangler versions upload --x-provision=false --x-auto-create=false --strict",
    "deploy:promote": "node tools/deploy-promote.mjs",
    "og-cards": "node tools/photos/gen-og-cards.mjs",
    "repo-card": "node tools/gen-repo-card.mjs",
    "gen:manifest": "node tools/gen-manifest.mjs",
    "gen:shell": "node tools/photos/gen-desktop-partial.mjs",
    "gen:mcp-cards": "node tools/gen-mcp-cards.mjs",
    "search:index": "node tools/generate-search-index.mjs",
    "photos": "bash tools/photos/add-photos.sh",
    "photos:check": "node tools/photos/check-photo-pipeline.mjs",
    "captions": "python3 tools/photos/gen-alt-text.py",
    "photos:env": "uv venv tools/photos/.venv --python 3.12 --allow-existing && uv pip install --python tools/photos/.venv/bin/python -r tools/photos/requirements.txt",
    "perf-budget": "node tools/perf-budget.mjs",
    "perf:snapshot": "node tools/perf-snapshot.mjs",
    "check-wrangler": "node tools/check-wrangler.mjs",
    "routes:check": "node tools/check-routes-harness.mjs",
    "routes:check:remote": "node tools/check-routes-harness.mjs --remote",
    "infra:check": "node tools/check-infra.mjs",
    "infra:apply": "node tools/apply-infra.mjs",
    "pages:check": "node tools/check-page-contracts.mjs",
    "tools:check": "node tools/check-tools.mjs",
    "test": "node --test tools/contract-tests.mjs",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc -p config/tsconfig.json && tsc -p config/tsconfig.browser.json",
    "typecheck:browser": "tsc -p config/tsconfig.browser.json",
    "shell:roll": "node tools/roll-shell-dictionary.mjs",
    "pages:roll": "node tools/roll-shell-dictionary.mjs --pages",
    "dict:roll": "node tools/roll-shell-dictionary.mjs --live",
    "dcz:check": "node tools/check-dictionary-support.mjs",
    "kitesurf:check": "node tools/check-kitesurf.mjs",
    "agent:check": "node tools/check-agent.mjs",
    "bun:check": "node tools/check-bun.mjs",
    "speculation:probe": "node tools/speculation-probe.mjs",
    "csp:sweep": "node tools/csp-sweep.mjs",
    "checkpoints:check": "node tools/check-checkpoints.mjs",
    "checkpoints:sync": "node tools/check-checkpoints.mjs --sync",
    "inp": "node tools/inp-lab.mjs",
    "release": "node tools/release-status.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260815.1",
    "@minify-html/node": "0.18.1",
    "@oxlint/plugins": "1.78.0",
    "lightningcss": "1.33.0",
    "oxc-minify": "0.144.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright-core": "^1.62.1",
    "typescript": "7.0.2",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "comment:undici": "undici arrives only through miniflare, which pins it EXACTLY, so npm cannot move it and dependabot cannot either. An `overrides` block forced 7.29.0 from 2026-08-05 until this commit, for five advisories in the 7.28.0 pin. Both miniflare consumers now ask for 7.29.0 themselves, so the override is gone. The floors are what replace it: `wrangler >= 4.120.0` and `cal`'s `@cloudflare/vitest-pool-workers >= 0.20.3` are the two versions whose miniflare (5.20260801.1-alpha) carries the fixed pin. Dropping EITHER floor puts 7.28.0 back at the hoisted position, silently, because npm hoists whichever exact pin it resolves first and the vulnerable one wins that race."
}
