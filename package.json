{
  "name": "aadhar-sh",
  "private": true,
  "description": "aadhar.sh - deploy-time transform only (authoring stays buildless; see build.mjs)",
  "type": "module",
  "workspaces": [
    "cal",
    "cf-garage",
    "lwe-ask",
    "serendipity"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "wrangler dev -c wrangler.dev.jsonc",
    "deploy": "wrangler deploy --x-provision=false --x-auto-create=false --strict",
    "og-cards": "node holding/scripts/gen-og-cards.mjs",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "search:index": "node scripts/generate-search-index.mjs",
    "photos": "bash holding/scripts/add-photos.sh",
    "photos:check": "node holding/scripts/check-photo-pipeline.mjs",
    "captions": "python3 holding/scripts/gen-alt-text.py",
    "perf-budget": "node perf-budget.mjs",
    "check-wrangler": "node scripts/check-wrangler.mjs",
    "routes:check": "node scripts/check-routes-harness.mjs",
    "infra:check": "node scripts/check-infra.mjs",
    "infra:apply": "node scripts/apply-infra.mjs",
    "pages:check": "node scripts/check-page-contracts.mjs",
    "test": "node --test contract-tests.mjs",
    "shell:roll": "node scripts/roll-shell-dictionary.mjs",
    "dcz:check": "node scripts/check-dictionary-support.mjs",
    "checkpoints:check": "node scripts/check-checkpoints.mjs",
    "checkpoints:sync": "node scripts/check-checkpoints.mjs --sync",
    "inp": "node scripts/inp-lab.mjs"
  },
  "devDependencies": {
    "@minify-html/node": "0.18.1",
    "esbuild": "0.28.1",
    "lightningcss": "1.33.0",
    "oxc-minify": "0.142.0",
    "playwright-core": "^1.62.1",
    "wrangler": "4.118.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@noble/post-quantum": "0.6.1"
  }
}
