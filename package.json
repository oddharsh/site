{
  "name": "aadhar-sh",
  "private": true,
  "description": "aadhar.sh - deploy-time transform only (authoring stays buildless; see build.mjs)",
  "type": "module",
  "workspaces": [
    "cal",
    "cf-garage",
    "lwe-ask",
    "serendipity"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "wrangler dev -c wrangler.dev.jsonc",
    "dev:remote": "node scripts/gen-remote-config.mjs wrangler.dev.jsonc && wrangler dev -c .wrangler.remote.jsonc",
    "deploy": "wrangler deploy --x-provision=false --x-auto-create=false --strict",
    "deploy:version": "wrangler versions upload --x-provision=false --x-auto-create=false --strict",
    "deploy:promote": "node scripts/deploy-promote.mjs",
    "og-cards": "node holding/scripts/gen-og-cards.mjs",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "gen:mcp-cards": "node scripts/gen-mcp-cards.mjs",
    "search:index": "node scripts/generate-search-index.mjs",
    "photos": "bash holding/scripts/add-photos.sh",
    "photos:check": "node holding/scripts/check-photo-pipeline.mjs",
    "captions": "python3 holding/scripts/gen-alt-text.py",
    "perf-budget": "node perf-budget.mjs",
    "perf:snapshot": "node scripts/perf-snapshot.mjs",
    "check-wrangler": "node scripts/check-wrangler.mjs",
    "routes:check": "node scripts/check-routes-harness.mjs",
    "routes:check:remote": "node scripts/check-routes-harness.mjs --remote",
    "infra:check": "node scripts/check-infra.mjs",
    "infra:apply": "node scripts/apply-infra.mjs",
    "pages:check": "node scripts/check-page-contracts.mjs",
    "test": "node --test contract-tests.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "shell:roll": "node scripts/roll-shell-dictionary.mjs",
    "pages:roll": "node scripts/roll-shell-dictionary.mjs --pages",
    "dcz:check": "node scripts/check-dictionary-support.mjs",
    "kitesurf:check": "node scripts/check-kitesurf.mjs",
    "checkpoints:check": "node scripts/check-checkpoints.mjs",
    "checkpoints:sync": "node scripts/check-checkpoints.mjs --sync",
    "inp": "node scripts/inp-lab.mjs",
    "release": "node scripts/release-status.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "@minify-html/node": "0.18.1",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "oxc-minify": "0.144.0",
    "playwright-core": "^1.62.1",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "comment:undici": "undici arrives only through miniflare, which pins it EXACTLY, so npm cannot move it and dependabot cannot either. An `overrides` block forced 7.29.0 from 2026-08-05 until this commit, for five advisories in the 7.28.0 pin. Both miniflare consumers now ask for 7.29.0 themselves, so the override is gone. The floors are what replace it: `wrangler >= 4.120.0` and `cal`'s `@cloudflare/vitest-pool-workers >= 0.20.3` are the two versions whose miniflare (5.20260801.1-alpha) carries the fixed pin. Dropping EITHER floor puts 7.28.0 back at the hoisted position, silently, because npm hoists whichever exact pin it resolves first and the vulnerable one wins that race.",
  "dependencies": {
    "@noble/post-quantum": "0.7.0"
  }
}
