{
  "name": "aadhar-sh",
  "private": true,
  "description": "aadhar.sh: a static-first Cloudflare Worker with a Windows XP interface",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun tools/build.ts",
    "dev": "bun tools/dev.ts",
    "dev:remote": "bun tools/lib/site-config.ts --dev && bun tools/gen-remote-config.ts .wrangler.dev.jsonc && bun tools/dev-stage.ts --watch -- node node_modules/wrangler/bin/wrangler.js dev -c .wrangler.remote.jsonc -c counter/wrangler.jsonc",
    "deploy:direct": "wrangler deploy --x-new-config --x-provision=false --x-auto-create=false --strict",
    "deploy:version": "wrangler versions upload --x-new-config --x-provision=false --x-auto-create=false --strict",
    "deploy:promote": "bun tools/deploy-promote.ts",
    "og-cards": "bun tools/photos/gen-og-cards.ts",
    "repo-card": "bun tools/gen-repo-card.ts",
    "gen:manifest": "bun tools/gen-manifest.ts",
    "gen:shell": "bun tools/photos/gen-desktop-partial.ts",
    "gen:mcp-cards": "bun tools/gen-mcp-cards.ts",
    "gen:dotfiles": "bun tools/gen-dotfiles.ts",
    "search:index": "bun tools/generate-search-index.ts",
    "photos": "bash tools/photos/add-photos.sh",
    "photos:check": "bun tools/photos/check-photo-pipeline.ts",
    "av2:build": "bash node_modules/av2-tone/encoder/build.sh --tuned",
    "av2:wasm": "DEST=public/garage/av2 bash node_modules/av2-tone/wasm/build.sh",
    "histograms:check": "bun tools/photos/check-histograms.ts",
    "archive:gate": "bun tools/photos/archive-gate.ts",
    "captions": "bun tools/photos/gen-alt-text.ts",
    "perf-budget": "bun tools/perf-budget.ts",
    "cpu:sweep": "node tools/cpu-sweep.ts",
    "served:manifest": "bun tools/served-manifest.ts",
    "served:check": "bun tools/check-served.ts",
    "perf:snapshot": "bun tools/perf-snapshot.ts",
    "deps:dedupe": "bun dedupe --check",
    "deps:audit": "bun audit",
    "check-wrangler": "bun tools/check-wrangler.ts",
    "wrangler:site": "bun tools/wrangler-site.ts",
    "cf": "bun tools/cf.ts",
    "routes:check": "node tools/check-routes-harness.ts",
    "routes:check:remote": "node tools/check-routes-harness.ts --remote",
    "infra:check": "bun tools/check-infra.ts",
    "infra:apply": "bun tools/apply-infra.ts",
    "labels:sync": "bun tools/sync-labels.ts",
    "pages:check": "bun tools/check-page-contracts.ts",
    "colors:drift": "bun tools/color-drift.ts",
    "tools:check": "bun tools/check-tools.ts",
    "derive:check": "bun tools/check-derivations.ts",
    "ua:survey": "bun tools/ua-survey.ts",
    "test": "bun test --parallel=4 --no-isolate --timeout=30000 --timings=config/test-timings.json --preload ./tools/lib/no-network.ts tools/tests/",
    "conflicts": "bun tools/conflict-triage.ts",
    "deps:pin": "bun tools/bump-deps.ts",
    "deps:snapshot": "bun --no-install tools/dependency-snapshot.ts",
    "test:node": "node --import ./tools/lib/no-network.ts --test --test-isolation=none tools/tests/*.test.ts",
    "lint": "bun tools/check-bun-lint.ts && bun tools/gen-runtime-types.ts && bun lint --type-aware",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun tools/gen-runtime-types.ts && bun tools/check-env.ts && bun tools/typecheck.ts",
    "types:gen": "bun tools/gen-runtime-types.ts",
    "env:check": "bun tools/check-env.ts",
    "check:fast": "bun run --parallel lint typecheck test format:check",
    "shell:roll": "bun tools/roll-shell-dictionary.ts",
    "pages:roll": "bun tools/roll-shell-dictionary.ts --pages",
    "family:roll": "bun tools/roll-shell-dictionary.ts --family",
    "dict:roll": "bun tools/roll-shell-dictionary.ts --live",
    "dcz:check": "bun tools/check-dictionary-support.ts",
    "q11:check": "bun tools/check-q11.ts",
    "agent:check": "bun tools/check-agent.ts",
    "webmcp:check": "bun tools/webmcp-catalog.ts",
    "bun:pin": "bun tools/bump-bun-pin.ts",
    "canary:bun": "bun tools/canary-bun.ts",
    "canary:wrangler": "bun tools/canary-wrangler.ts",
    "canary:browsers": "bun tools/canary-browsers.ts",
    "wrangler:pin": "bun tools/bump-wrangler-pin.ts",
    "timbrado": "bun node_modules/timbrado/src/cli.ts",
    "node:pin": "bun tools/check-node-pin.ts",
    "speculation:report": "bun tools/speculation-report.ts",
    "serendipity:roles": "bun tools/serendipity-role-baseline.ts",
    "csp:sweep": "bun tools/csp-sweep.ts",
    "checkpoints:check": "bun tools/check-checkpoints.ts",
    "checkpoints:sync": "bun tools/check-checkpoints.ts --sync",
    "checkpoints:record": "bun tools/check-checkpoints.ts --record",
    "indexnow": "bun tools/indexnow.ts",
    "ask:eval": "bun tools/ask-rank-eval.ts",
    "webmention:eval": "bun tools/webmention-sort-eval.ts"
  },
  "devDependencies": {
    "@cloudflare/config": "0.28.1",
    "@oxlint/plugins": "1.90.0",
    "@types/bun": "1.4.4",
    "av2-tone": "github:oddharsh/av2-tone#462f9ca175a5e4f9c1640ed6d8a47266e2590418",
    "lightningcss": "1.33.0",
    "oxc-minify": "0.155.0",
    "playwright-core": "1.64.1",
    "timbrado": "github:oddharsh/timbrado#ec6c6b19dd97b922ce86f49d60711abfe5924670",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "cal",
    "cf-garage",
    "config/dev",
    "lwe-ask",
    "serendipity"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "catalog": {
    "wrangler": "https://pkg.pr.new/cloudflare/workers-sdk/wrangler@cda7856"
  },
  "$comment": "Toolchain ownership and validation commands: docs/TOOLING.md. Shared dependency pins: catalog below; runtime pins: config/bun-pin.json and .node-version."
}
