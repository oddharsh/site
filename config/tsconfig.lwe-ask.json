{
  // The separately deployed LWE ask Worker uses workerd globals. Each auxiliary
  // Worker has its own program and dependency graph; combining host tests with
  // Worker source would admit globals unavailable in one of those runtimes.
  // Garage and Reader tests have separate host programs. lwe-ask currently has
  // no test suite. tools/typecheck.ts fails on a source tree no program holds.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    // Workers globals only. With lib.dom loaded, its CacheStorage shadows
    // Cloudflare's, which is the collision tsconfig.json's header documents.
    "lib": ["esnext"],
    // index.ts imports its two sibling modules by their real `.ts` filenames,
    // which is the one specifier that resolves in both trees (tsconfig.json's
    // header has the long version). Without this tsc rejects them outright and
    // never reaches a real finding.
    "allowImportingTsExtensions": true,
    // Empty rather than omitted (an omitted `types` admits every @types/*, bun's
    // included); the Workers runtime comes in through `include`, generated by
    // tools/gen-runtime-types.ts from the pinned workerd. See tsconfig.json.
    "types": [],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Checked without a diagnostic baseline; see tsconfig.json for the
    // separate full-strictness migration.
    "strictNullChecks": true,
    "strict": false
  },
  // A GLOB rather than a file list, so a new module joins the program by
  // existing. The allowlist habit is what let ten client islands go unchecked.
  // cloudflare.config.ts is named here for the reason tsconfig.cf-garage.json
  // gives: checked beside the Worker it configures (since `cf migrate`, 2026-09-28).
  "include": ["../lwe-ask/src/**/*.ts", "../lwe-ask/cloudflare.config.ts", "../lwe-ask/wrangler.config.ts", "./.generated/workers-runtime-aux.d.ts"]
}
