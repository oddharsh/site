{
  // Host tools, contract tests, and page generators use Bun/Node globals.
  // Worker modules imported by these tools also enter this program. 
  // tools/typecheck.ts reports this program's diagnostics only for tools/ and
  // pipelines/. The Worker program checks imported source against its own
  // runtime.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Current diagnostic counts live in ts-baseline.json. The checker
    // rejects regressions and improvements whose baseline was not updated.
    // Full strictness is a separate migration; see tsconfig.json.
    "strictNullChecks": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Imports name actual .ts files: Node strips types and Bun loads them;
    // neither path needs files emitted by tsc.
    "allowImportingTsExtensions": true,
    "lib": ["esnext", "dom"],
    // bun-types carries the node globals too, so this is one entry rather than
    // two. It also declares the bun-only globals the tools now use directly,
    // HTMLRewriter among them.
    "types": ["bun"]
  },
  // Tools, contract tests and authoring generators use host globals. Inline
  // demos under specs/ belong to the DOM program instead.
  "include": [
    "../tools/**/*.ts",
    "../pipelines/**/*.ts"
  ],
  // The two vendored encoder builds are gitignored third-party checkouts, and
  // the AV2 one fetches FlatBuffers' own TypeScript under build/, which the glob
  // above reads as tools of ours. Same reason tools/lib/derive-writers.ts skips
  // them. Naming `exclude` replaces tsc's default, so node_modules is restated.
  "exclude": [
    "../**/node_modules",
    "../pipelines/**/specs/**",
    "../tools/photos/libavif/src",
    "../tools/photos/libavif/build"
  ]
}
