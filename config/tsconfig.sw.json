{
  // tsconfig.sw.json — the service worker, which is neither a browser module nor
  // a Worker module.
  //
  // sw.js runs in a ServiceWorkerGlobalScope: `skipWaiting`, `clients` and
  // `registration` are globals there and exist in NO other environment, which is
  // why it needs lib.webworker. That lib conflicts with lib.dom; keeping this
  // program separate checks the service worker against its actual environment.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "webworker"],
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // This program is checked without a diagnostic baseline. Full strictness
    // is a separate migration; see tsconfig.json.
    "strictNullChecks": true,
    "strict": false
  },
  "include": ["../src/client/sw.js", "../src/client/sw-globals.d.ts"]
}
