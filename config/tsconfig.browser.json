{
  // Browser modules need the DOM's globals, while the Worker check deliberately
  // excludes them so Cloudflare's CacheStorage remains authoritative there.
  // Keep this a second project: combining the two environments makes both less
  // accurate and recreates the caches.default collision documented next door.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    // The served URL root is a COMPOSITE now: build.mjs stages www/, src/client/
    // and src/styles/ into one tree, so /hoist.js and /nav.js resolve out of
    // src/client while /index.html and /images/* still come from public/. Listing
    // both is what keeps an absolute specifier checkable after the split.
    "paths": { "/*": ["../src/client/*", "../src/styles/*", "../src/pages/*", "../public/*"] },
    "lib": ["esnext", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false
  },
  // The shared hover engine and its two consumers are included together because
  // tsc follows their static imports. The shell's Run and tray islands complete
  // the first-interaction surface without pulling Worker modules into this graph.
  "include": [
    "../src/client/hoist.js",
    "../src/client/tooltip.js",
    "../src/client/infotip.js",
    "../src/client/nav.js",
    "../src/client/nav-run.js",
    "../src/client/nav-tray.js"
  ]
}
