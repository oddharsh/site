{
  // Browser modules need the DOM's globals, while the Worker check deliberately
  // excludes them so Cloudflare's CacheStorage remains authoritative there.
  // Keep this a second project: combining the two environments makes both less
  // accurate and recreates the caches.default collision documented next door.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    // The served URL root is a COMPOSITE now: build.mjs stages public/, src/client/
    // and src/styles/ into one tree, so /hoist.js and /nav.js resolve out of
    // src/client while /index.html and /images/* still come from public/. Listing
    // both is what keeps an absolute specifier checkable after the split.
    "paths": { "/*": ["../src/client/*", "../src/styles/*", "../public/*"] },
    "lib": ["esnext", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false
  },
  // A GLOB, not a list. This named six files until 2026-08-20, and by then ten
  // more client islands had shipped without joining it — including lens.js, the
  // largest client asset the site serves. An allowlist only grows when somebody
  // remembers, so its coverage silently stops following the code, which is the
  // same failure shape as every scanner in this repo that lost its target.
  //
  // public/**/*.js is here for the one island that lives outside src/client:
  // /lwe/ask.js ships from public/ because it is page-specific rather than part
  // of the shell.
  // sw.js is EXCLUDED because it is a service worker, not a browser module; it
  // has its own program in tsconfig.sw.json, where its globals are real. This is
  // an exclusion with a checker behind it, not a gap.
  "exclude": ["../src/client/sw.js"],
  "include": [
    "../src/client/**/*.js",
    "../src/client/**/*.d.ts",
    "../public/**/*.js"
  ]
}
