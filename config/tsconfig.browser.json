{
  // Browser modules need the DOM's globals, while the Worker check deliberately
  // excludes them so Cloudflare's CacheStorage remains authoritative there.
  // Keep this a second project: combining the two environments makes both less
  // accurate and recreates the caches.default collision documented next door.
  "compilerOptions": {
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    // Absolute imports resolve across the served asset trees: src/client/,
    // src/styles/, and public/. Documents are authored separately in src/pages/.
    "paths": { "/*": ["../src/client/*", "../src/styles/*", "../public/*"] },
    "lib": ["esnext", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Type-only changes must preserve the minified asset bytes and hashes.
    // config/ts-baseline.json holds the remaining per-file diagnostic counts.
    "strictNullChecks": true,
    "strict": false
  },
  // Browser programs and injected page demos use DOM globals. The service
  // worker has its own program. Vendored pretext remains JavaScript and is
  // still checked; its published bytes are not ours to migrate.
  "exclude": ["../src/client/sw.ts"],
  "include": [
    "../src/client/**/*.ts",
    "../src/client/garage/pretext.lib.js",
    "../pipelines/**/specs/**/*.ts"
  ]
}
