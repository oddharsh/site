{
  // The Reader lens Worker has its own workerd program and deployment.
  //
  // See tsconfig.lwe-ask.json's header for why each auxiliary Worker gets its
  // own program and why its tests are out of scope. Two things are specific
  // to this one.
  //
  // It is outside the root workspace: readability and htmlparser2 are runtime
  // dependencies; linkedom is the test oracle. Install in lens-reader/ and run
  // bun run typecheck there. Resolution starts from each source file, so the
  // config can stay here while dependencies live in lens-reader/node_modules.
  //
  // `allowImportingTsExtensions` is load-bearing: reader.ts imports
  // `../../src/worker/lib/public-fetch.ts` by its real filename, which is the ONE
  // specifier that resolves in both trees (tsconfig.json's header has the long
  // version). Without it tsc rejects that import and never reaches a finding.
  // Pulling public-fetch.ts in transitively is correct here rather than the artifact it
  // would be under node globals, since both files run on Workers.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["esnext"],
    // Empty rather than omitted (an omitted `types` admits every @types/*, bun's
    // included); the Workers runtime comes in through `include`, generated by
    // tools/gen-runtime-types.ts from the pinned workerd. See tsconfig.json.
    "types": [],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Checked without a diagnostic baseline; see tsconfig.json for the
    // separate full-strictness migration.
    "strictNullChecks": true,
    "strict": false
  },
  "include": ["../lens-reader/src/**/*.ts", "./.generated/workers-runtime.d.ts"]
}
