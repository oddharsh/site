{
  // tsconfig.cf-garage.json — the Garage demo Worker at cf-garage/, which owns
  // /garage/cf/* and deploys on its own.
  //
  // See tsconfig.lwe-ask.json's header for why each auxiliary Worker gets its
  // own program, why the globals are Cloudflare's alone, and why the test file
  // beside this src tree is deliberately out of scope.
  //
  // This one is the sharpest case for Workers globals over node's. cf-garage
  // sends `fetch(url, { cf: { ... } })`, and under bun-types that reads as
  // `'cf' does not exist in type 'RequestInit'` (measured 2026-08-21), which is
  // a missing global rather than a finding: the same call is clean here.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    // Empty rather than omitted (an omitted `types` admits every @types/*, bun's
    // included); the Workers runtime comes in through `include`. Unlike the
    // other programs here it is NOT the site's config/.generated/ file: wrangler
    // writes cf-garage/.cloudflare/types/index.d.ts from cloudflare.config.ts
    // (the `Env` inferred from its `env` block, plus the runtime at this
    // Worker's own compatibility date and flags), and tools/gen-runtime-types.ts
    // runs the build that writes it. Gitignored, never committed. Including
    // both files would declare every Workers global twice.
    "types": [],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Checked without a diagnostic baseline; see tsconfig.json for the
    // separate full-strictness migration.
    "strictNullChecks": true,
    "strict": false,
    // From workers-sdk#15914 on, the generated index.d.ts types `Env` through
    // `import("cf/config")`, and this repo installs `@cloudflare/config`
    // rather than the `cf` CLI that re-exports it (cloudflare.config.ts says
    // why). Unmapped, that import resolves to nothing and `Env` quietly loses
    // every binding, so the failure is TS2339 on `env.COUNTER` rather than a
    // missing module. Delete this line if `cf` ever becomes a dependency.
    "paths": { "cf/config": ["../node_modules/@cloudflare/config/dist/public.d.mts"] }
  },
  // cloudflare.config.ts is IN this program rather than in tsconfig.tools.json,
  // and the distinction is which globals it needs. It is not runtime code and it
  // never ships in the bundle, so tools/ is the reflexive home; but it imports
  // `@cloudflare/config/public`, whose binding factories are generic over
  // Workers types, and it is the file the Worker's own `Env` is inferred FROM.
  // Checking it beside the Worker it configures is what makes a wrong binding
  // name a type error here rather than a 500 in production.
  "include": ["../cf-garage/src/**/*.ts", "../cf-garage/cloudflare.config.ts", "../cf-garage/wrangler.config.ts", "../cf-garage/.cloudflare/types/index.d.ts"]
}
