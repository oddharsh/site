{
  // tsconfig.cf-garage.json — the Garage demo Worker at cf-garage/, which owns
  // /garage/cf/* and deploys on its own.
  //
  // See tsconfig.lwe-ask.json's header for why each auxiliary Worker gets its
  // own program, why the globals are Cloudflare's alone, and why the test file
  // beside this src tree is deliberately out of scope.
  //
  // This one is the sharpest case for Workers globals over node's. cf-garage
  // sends `fetch(url, { cf: { ... } })`, and under bun-types that reads as
  // `'cf' does not exist in type 'RequestInit'` (measured 2026-08-21), which is
  // a missing global rather than a finding: the same call is clean here.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // Two control-flow checks, set here because they are set in tsconfig.json
    // and a program is only as strict as its own options. Both cost nothing:
    // +0 diagnostics on every one of the ten programs, measured 2026-08-27.
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // strictNullChecks ON. `strict` stays off: it bundles noImplicitAny,
    // which is 7,197 diagnostics of annotation labour across this repo, and
    // raising the two together buries the checks that find bugs under the
    // ones that find missing annotations. This program is clean under it,
    // and a contract test keeps the set of clean programs from shrinking.
    "strictNullChecks": true,
    "strict": false
  },
  // cloudflare.config.ts is IN this program rather than in tsconfig.tools.json,
  // and the distinction is which globals it needs. It is not runtime code and it
  // never ships in the bundle, so tools/ is the reflexive home; but it imports
  // `wrangler/experimental-config`, whose binding factories are generic over
  // Workers types, and it is the file the Worker's own `Env` is inferred FROM.
  // Checking it beside the Worker it configures is what makes a wrong binding
  // name a type error here rather than a 500 in production.
  "include": ["../cf-garage/src/**/*.ts", "../cf-garage/cloudflare.config.ts"]
}
