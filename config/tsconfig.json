{
  // One no-emit check over the two server-side runtime surfaces: the booking
  // module remains checked JavaScript, while the site Worker is TypeScript that
  // both Node's type stripper and Wrangler can load directly.
  //
  // The Worker conversion initially left this include on `**/*.js`, so tsc saw
  // cal plus one transitively imported Worker module and skipped the other 68.
  // contract-tests now executes `tsc --listFilesOnly` and compares the program
  // with the directory, making the scope part of the contract rather than a
  // comment. The remaining explicit quarantine lives in ts-migration.json.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    // A .ts specifier is the only one that resolves in BOTH trees: node strips
    // types at runtime and wrangler bundles the same file, so an import has to
    // name the file that exists rather than the one a compiler would emit.
    // Nothing is emitted anyway (noEmit above).
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    // Node strips these files directly in contract tests and Wrangler bundles
    // the same source for workerd. Keep syntax inside the erasable intersection
    // so neither path depends on a TypeScript transform the other does not run.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noFallthroughCasesInSwitch": true,
    // A handler that falls off the end returns `undefined` where the runtime
    // wants a Response, and the route table types its entries as `Function`, so
    // nothing downstream catches it. +0 diagnostics across all ten programs,
    // measured 2026-08-27, which is what made it worth setting everywhere
    // rather than here alone.
    "noImplicitReturns": true,
    // Workers globals only. With the DOM lib loaded, its CacheStorage shadows
    // Cloudflare's and every `caches.default` reads as an error.
    "lib": ["esnext"],
    // EMPTY on purpose, and load-bearing: an omitted `types` pulls in every
    // @types/* package, which here means bun's globals landing in the Worker's
    // scope. The Workers runtime declarations arrive through `include` below
    // instead, as a file tools/gen-runtime-types.ts writes from the pinned
    // workerd; that file's header says why it replaced @cloudflare/workers-types
    // on 2026-09-02 and what was measured before it did.
    "types": [],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // Not `strict` yet. The Worker was converted from unannotated JavaScript and
    // the explicit quarantine must shrink before a global strictness migration.
    // strictNullChecks ON, against the ratchet in check-worker-types.ts. The
    // program carried 572 diagnostics under it; 264 are fixed and the rest are
    // recorded per file in config/ts-worker-baseline.json, where they can only
    // fall. `strict` stays false for the reason the comment below gives:
    // noImplicitAny is 7,197 diagnostics of annotation labour repo-wide and
    // would bury this.
    "strictNullChecks": true,
    "strict": false
  },
  // Paths are relative to THIS file, which lives in config/ — hence the `../`.
  // The generated runtime surface is a literal path rather than a glob, so a
  // missing file (typecheck run without its generator) fails on the include
  // instead of checking the Worker against no globals at all.
  "include": ["../cal/src/**/*.ts", "../src/worker/**/*.ts", "./.generated/workers-runtime.d.ts"]
}
