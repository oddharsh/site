{
  // tsconfig.cf-garage-test.json — the Garage demo Worker's `bun test` suite.
  //
  // BUN GLOBALS, unlike tsconfig.cf-garage.json beside it, and the split is the
  // whole reason this is a second program: the SOURCE runs on workerd and the
  // TEST runs on bun, so no single `types` entry is right for both. Declaring
  // the union instead would let a Workers-only call pass in a host file and a
  // host-only call pass in a Worker, which is the accuracy every program header
  // in this directory is protecting.
  //
  // The consequence is that importing the Worker pulls cf-garage/src in against
  // the wrong globals: `fetch(url, { cf: { ... } })` reads as `'cf' does not
  // exist in type 'RequestInit'` here and is clean next door. That diagnostic is
  // a missing declaration rather than a finding, so this program is NOT run
  // bare. tools/typecheck.ts reports only cf-garage/test/'s own diagnostics
  // from it.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["esnext"],
    // bun-types carries bun's globals and node's, which is what these tests run on. Same
    // entry tsconfig.tools.json uses, for the same reason.
    "types": ["bun"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Checked without a diagnostic baseline; see tsconfig.json for the
    // separate full-strictness migration.
    "strictNullChecks": true,
    "strict": false
  },
  "include": ["../cf-garage/test/**/*.mjs"]
}
